{
  "name": "wix-editor-mcp",
  "version": "0.4.0",
  "description": "MCP server for the classic Wix Editor (Harmony/Odeditor). Create and edit pages, text, images, SEO, navigation, CMS collections, and blog posts through the editor's internal documentServices API and the Wix data gateway. Playwright-driven, for sites where Wix has no public page API.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "wix-editor-mcp": "server.js"
  },
  "scripts": {
    "import-login": "node import-cookies.mjs"
  },
  "files": [
    "server.js",
    "chrome-cookies.mjs",
    "import-cookies.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "wix",
    "wix-editor",
    "wix-api",
    "wix-automation",
    "wix-cms",
    "wix-blog",
    "wix-seo",
    "documentservices",
    "playwright",
    "browser-automation",
    "seo",
    "cms",
    "automation",
    "claude",
    "ai"
  ],
  "author": "khuur.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naieum/wix-editor-mcp.git"
  },
  "bugs": "https://github.com/naieum/wix-editor-mcp/issues",
  "homepage": "https://github.com/naieum/wix-editor-mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.49.0",
    "zod": "^3.24.0"
  }
}
